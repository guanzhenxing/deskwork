    "@deepseek-ai/dsh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.1",
    "@deepseek-ai/dsh-base": "0.2.0-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.1",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.1",
    "@dsh-desktop/desktop-contracts": "workspace:*",
    "@dsh-desktop/home-lease": "workspace:*"
