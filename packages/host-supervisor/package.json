{
  "name": "@dsh-desktop/host-supervisor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host-runner": {
      "types": "./lib/host-runner.d.ts",
      "default": "./lib/host-runner.js"
